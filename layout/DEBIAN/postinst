#!/bin/sh
# dpkg does not tell springboard about an app bundle; this rebuilds the app cache so the icon appears

if [ -d /var/jb/Applications/Noshigram.app ] && [ ! -d /Applications/Noshigram.app ]; then
  JBROOT=/var/jb
else
  JBROOT=
fi
APP=${JBROOT}/Applications/Noshigram.app
UICACHE=${JBROOT}/usr/bin/uicache
[ -x "$UICACHE" ] || UICACHE=/usr/bin/uicache
KILLALL=${JBROOT}/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/bin/killall

# the app replaces its own files when it updates and changes its icon in Info.plist, which only the owner of the folder may do
chown -R mobile:wheel "$APP" 2>/dev/null || true
chmod 755 "$APP" "$APP/Noshigram" 2>/dev/null || true

# ios 5 and 6 give notification settings only to the apps of the user, so an app in /Applications gets no banner, no entry in the notification center and no
# row in the settings; the executable tags the bundle as internal and sets the switch that keeps the icon, which the removal of the package takes back
if [ -z "$JBROOT" ]; then
  "$APP/Noshigram" --system-notifications on || echo "noshigram: the notification setup for /Applications failed, banners will not show" >&2
fi

# the old binary keeps running from memory after an upgrade
"$KILLALL" -9 Noshigram >/dev/null 2>&1 || true

[ -x "$UICACHE" ] || exit 0

# ios 7 and older keep the app list in mobile's installation cache, and uicache run as
# root stops at "cannot open cache file. incorrect user?"; newer uicache needs root
INSTALL_CACHE=/var/mobile/Library/Caches/com.apple.mobile.installation.plist
SU=/bin/su
[ -x "$SU" ] || SU=/usr/bin/su
refresh_app_cache() {
  if [ -z "$JBROOT" ] && [ -f "$INSTALL_CACHE" ] && [ -x "$SU" ]; then
    "$SU" - mobile -c "$UICACHE -p $APP" && return 0
    "$SU" - mobile -c "$UICACHE" && return 0
  fi
  "$UICACHE" -p "$APP" || "$UICACHE"
}

# ios 5 and 6 register the app after uicache but keep drawing the icon springboard loaded
# blank until it restarts. uicache of those systems has no -p and rebuilds every app, so it
# outlasts a fixed delay and a springboard started before it returns loads the blank icon again;
# the restart waits for uicache, then for dpkg (the parent of this script) to record the
# configured state, at most a minute
RESPRING=0
if [ -z "$JBROOT" ] && [ -f "$INSTALL_CACHE" ] && [ "${NOSHI_SKIP_RESPRING:-0}" != "1" ]; then
  RESPRING=1
fi
DPKG_PID=$PPID

# backgrounding avoids an ios 6 uicache deadlock while the old app is still alive
(
  refresh_app_cache || true
  [ "$RESPRING" = 1 ] || exit 0
  WAITED=0
  while [ "$WAITED" -lt 60 ] && kill -0 "$DPKG_PID" 2>/dev/null; do
    sleep 1
    WAITED=$((WAITED + 1))
  done
  "$KILLALL" -9 SpringBoard || true
) </dev/null >/dev/null 2>&1 &

exit 0
